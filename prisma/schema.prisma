// Prisma schema for Akintola portfolio admin (simplified)
// Local dev: postgresql via Neon/Supabase. See .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// Generic key/value store for free-form copy (about bio, contact info, etc.)
// `value` is JSON-encoded text.
model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Blog post / "Field Note"
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  coverImage  String?
  body        String   // markdown
  tags        String   @default("[]") // JSON array of strings
  publishedAt DateTime @default(now())
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

// Certificates / credentials shown on About page
model Certificate {
  id        String   @id @default(cuid())
  title     String
  issuer    String?
  year      String?
  image     String?
  href      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Project / portfolio gallery item
model Project {
  id        String   @id @default(cuid())
  n         String   @default("")
  year      String   @default("")
  title     String
  desc      String   @default("")
  tags      String   @default("[]")
  href      String?
  venue     String?
  role      String?
  image     String   @default("")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact channels (email, phone, social)
model ContactChannel {
  id        String   @id @default(cuid())
  label     String
  value     String
  href      String
  icon      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// "At a glance" sidebar facts on About page
model AboutFact {
  id        String   @id @default(cuid())
  k         String
  v         String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}
